{
  "name": "estudo-app",
  "version": "0.0.0",
  "scripts": {
    "ng": "ng",
    "conteudo": "node scripts/gerar-conteudo.mjs",
    "test:fala": "node --no-warnings --test src/app/audio/fala.test.mts",
    "prestart": "npm run conteudo",
    "start": "ng serve",
    "prebuild": "npm run conteudo",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "ng test"
  },
  "prettier": {
    "printWidth": 100,
    "singleQuote": true,
    "overrides": [
      {
        "files": "*.html",
        "options": {
          "parser": "angular"
        }
      }
    ]
  },
  "private": true,
  "packageManager": "npm@11.12.1",
  "dependencies": {
    "@angular/cdk": "^21.2.14",
    "@angular/common": "^21.0.0",
    "@angular/compiler": "^21.0.0",
    "@angular/core": "^21.0.0",
    "@angular/forms": "^21.0.0",
    "@angular/material": "^21.2.14",
    "@angular/platform-browser": "^21.0.0",
    "@angular/router": "^21.0.0",
    "@angular/service-worker": "^21.0.0",
    "@fontsource/roboto": "^5.3.0",
    "marked": "^18.1.3",
    "material-icons": "^1.13.14",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^21.0.4",
    "@angular/cli": "^21.0.4",
    "@angular/compiler-cli": "^21.0.0",
    "typescript": "~5.9.2"
  }
}
